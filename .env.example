# === Core model providers ===
OPENAI_API_KEY=<your-openai-api-key> # Required for OpenAI-hosted models.
OPENAI_MODEL=gpt-4o-mini # Default provider model used when Chatwoot webhook doesn't override it.

# === Database & caching ===
DATABASE_URL="postgresql://user:password@localhost:5432/dbname" # Primary Postgres connection for Prisma.
REDIS_URL=redis://localhost:6379 # Redis instance for queues, rate limiting, and caching.
REDIS_PORT=6379 # Optional: overrides Redis port for local test utilities.
SESSION_RETENTION_DAYS=30 # Controls automatic cleanup of ended chat sessions.

# === Complaint submission routing ===
INTERNAL_API_BASE_URL=https://internal-api.example # Absolute base for server-side calls to Next.js API routes.
NEXT_PUBLIC_APP_URL=http://localhost:3000 # Public origin exposed to the browser; also used as a fallback base URL.

# === Chatwoot API credentials ===
CHATWOOT_URL=https://chatwoot.example # Base URL for the Chatwoot installation (no trailing slash).
CHATWOOT_APP_TOKEN=<chatwoot-app-token> # API token for server-to-server Chatwoot requests.
CHATWOOT_BOT_TOKEN=<bot-access-token> # Token that allows the bot to send messages via Chatwoot.
AGENT_TOKENS='{"1":"agent-1-secret","2":"agent-2-secret"}' # JSON map of Chatwoot agent IDs to shared secrets.
CHATWOOT_TIMEOUT_MS=15000 # Default timeout (ms) for Chatwoot HTTP requests before retrying.

# === Chatwoot webhook + provider behaviour ===
CHATWOOT_WEBHOOK_MODEL=gpt-4o-mini # Default model the webhook uses when invoking the provider.
CHATWOOT_WEBHOOK_PROVIDER=openai # Provider slug used to resolve the LLM implementation.
CHATWOOT_PROVIDER_MAX_RETRIES=3 # Max retries when provider executions fail.
CHATWOOT_PROVIDER_RETRY_BASE_MS=500 # Initial backoff (ms) between provider retries.
CHATWOOT_PROVIDER_RETRY_MAX_MS=4000 # Upper bound (ms) for provider retry delays.
CHATWOOT_PROVIDER_RETRY_ENABLE_JITTER=true # Whether to randomise retry delays for provider calls.

# === Chatwoot job queue configuration ===
CHATWOOT_QUEUE_USE_REDIS=true # Toggle between in-memory and Redis-backed job queue.
CHATWOOT_QUEUE_CONCURRENCY=2 # Number of concurrent webhook jobs processed.
CHATWOOT_QUEUE_JOB_TIMEOUT_MS=60000 # Max runtime (ms) allowed for a single webhook job.
CHATWOOT_QUEUE_MAX_ATTEMPTS=3 # Retry attempts for failing webhook jobs.
CHATWOOT_QUEUE_RETRY_BASE_DELAY_MS=500 # Base delay (ms) before retrying a failed job.
CHATWOOT_QUEUE_RETRY_BACKOFF_FACTOR=2 # Multiplier applied to each subsequent retry delay.
CHATWOOT_QUEUE_RETRY_MAX_DELAY_MS=5000 # Maximum delay (ms) allowed between job retries.

# === Chatwoot image insights ===
CHATWOOT_IMAGE_MODEL=gpt-4o-mini-vision # Vision model used for analysing attachments.
CHATWOOT_IMAGE_SEARCH_PROVIDER=openai # Provider that services image-search prompts.
CHATWOOT_IMAGE_KB_LIMIT=3072 # Max image size (KB) that will be sent for analysis.

# === Token budgeting ===
CHATWOOT_DEFAULT_TOKEN_LIMIT=6000 # Fallback prompt budget when no provider-specific limit is set.
CHATWOOT_OPENAI_TOKEN_LIMIT=6000 # Token ceiling when using OpenAI.
CHATWOOT_OLLAMA_TOKEN_LIMIT=4000 # Token ceiling when using native Ollama models.
CHATWOOT_OLLAMA_OPENAI_TOKEN_LIMIT=4000 # Token ceiling when using Ollama's OpenAI-compatible endpoint.

# === Message guardrails ===
LARGE_MESSAGE_THRESHOLD=1200 # Character count that triggers message summarisation.
MAX_UNSUMMARIZED_MESSAGES=12 # Max backlog of unsummarised messages kept per conversation.

# === Knowledge base ingestion ===
TEXT_SPLITTER_CHUNK_SIZE=1500 # Chunk size used when vectorising documents.
TEXT_SPLITTER_CHUNK_OVERLAP=200 # Overlap between consecutive chunks during ingestion.
OLLAMA_SEARCH_THRESHOLD=0.5 # Minimum relevance score for Ollama knowledge-base matches.
SCRAPE_ARTIFACT_DEBUG=false # Enable verbose artifact discovery logs when rerunning ingestion.

# === Ollama model configuration ===
OLLAMA_MODEL=llama3.2 # Default Ollama model for local inference.
OLLAMA_NUM_CTX=32768 # Context window supplied to Ollama models.
OLLAMA_HOST=http://localhost:11434 # Base URL for the Ollama runtime.
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1 # Ollama's OpenAI-compatible endpoint (if enabled).
OLLAMA_OPENAI_API_KEY=ollama # Dummy API key for the Ollama OpenAI shim.

# === Release / handoff controls ===
RELEASE_MAX_ATTEMPTS=5 # Max retries when releasing an agent fails.
RELEASE_RETRY_BASE_MS=1000 # Base backoff (ms) between release retries.

# === Scheduler ===
SCHEDULER_TIMEZONE=Africa/Accra # IANA timezone used by the scheduler worker (default Africa/Accra).
AUTO_RUN_MANUAL_WITH_NEXT=false # When true, the scheduler will enqueue manual jobs automatically at their nextRunAt.
NEXT_PUBLIC_AUTO_RUN_MANUAL_WITH_NEXT=false # Client-side default for the manual auto-run toggle on job forms.

# === Scraper defaults ===
AUTOMATION_BASE_URL=https://automationghana.com/sitemap_index.xml # Default sitemap/root URL used by bundled scraper presets.
WOOCOMMERCE_API_BASE=https://store.example.com/wp-json/wp/v2 # Override the WooCommerce REST API base when running product crawls.
SCRAPE_TARGET_URL=https://store.example.com # Optional override for standalone script runs; falls back to preset defaults.
SCRAPE_WOOCOMMERCE_CATEGORIES='["tools-and-measuring-equipment"]' # JSON or comma-separated list of category slugs for WooCommerce crawls.

# Optional debugging knobs
# PRISMA_* environment variables and DEBUG can be set as needed for advanced troubleshooting.
